<div class="application-detail-page">
	<div class="application-detail-container">
		<div class="application-detail-header">
			<div class="application-detail-back">
				<%= link_to "← Retour aux candidatures", applications_path, class: "back-link" %>
			</div>

			<div class="application-detail-logo">
				<h1>STAFOTEL</h1>
				<p>Dossier candidature</p>
			</div>
		</div>

		<div class="application-detail-meta">
			<div class="meta-item">
				<span class="label">Candidature N°</span>
				<span class="value">#<%= @application.id %></span>
			</div>
			<div class="meta-item">
				<span class="label">Date</span>
				<span class="value"><%= l(@application.created_at, format: :long) %></span>
			</div>
			<div class="meta-item">
				<span class="label">Statut</span>
				<span class="value status-<%= @application.status %>">
					<% case @application.status
						 when "pending" %>En attente
					<% when "accepted" %>Acceptée
					<% when "rejected", "refused" %>Refusée
					<% else %>
						<%= @application.status.to_s.humanize %>
					<% end %>
				</span>
			</div>
		</div>

		<div class="application-detail-divider"></div>

		<div class="application-detail-content">
			<section class="detail-section">
				<h3 class="section-title">Poste Concerné</h3>
				<div class="job-card">
					<h2><%= @application.job&.title || "Poste" %></h2>
					<% if @application.job&.description.present? %>
						<p><%= simple_format(@application.job.description) %></p>
					<% else %>
						<p class="empty-text">Aucune description de poste disponible.</p>
					<% end %>
				</div>
			</section>

			<section class="detail-section">
				<h3 class="section-title">Contact</h3>
				<div class="contact-grid">
					<div class="contact-item">
						<span class="label">Nom</span>
						<span class="value"><%= [@application.contact&.firstname, @application.contact&.lastname].compact.join(" ").presence || "Non renseigné" %></span>
					</div>
					<div class="contact-item">
						<span class="label">Email</span>
						<span class="value"><%= @application.contact&.email.presence || "Non renseigné" %></span>
					</div>
					<div class="contact-item">
						<span class="label">Téléphone</span>
						<span class="value"><%= @application.contact&.phone.presence || "Non renseigné" %></span>
					</div>
				</div>
			</section>

			<section class="detail-section">
				<h3 class="section-title">Message Du Candidat</h3>
				<div class="message-card">
					<% if @application.message.present? %>
						<%= simple_format(@application.message) %>
					<% else %>
						<p class="empty-text">Aucun message n'a été ajouté pour cette candidature.</p>
					<% end %>
				</div>
			</section>
		</div>

		<% if current_user.admin? %>
			<div class="application-detail-actions">
				<%= link_to "Supprimer la candidature",
										application_path(@application),
										data: { turbo_method: :delete, turbo_confirm: "Supprimer définitivement cette candidature ?" },
										class: "btn-delete-application" %>
			</div>
		<% end %>
	</div>
</div>
