<div class="container application-page">
  <%= link_to job_path(@job), class: "back-link-stylized" do %>
    <span class="back-icon">
      <i class="fas fa-arrow-left"></i>
    </span>
    <span class="back-text">Retour au poste</span>
  <% end %>

  <div class="application-header">
    <h1>Candidature</h1>
    <div class="header-divider"></div>
    <p class="job-title">Poste : <%= @job.title %></p>
  </div>

  <div class="application-content">
    <div class="job-preview-card">
      <div class="preview-header">
        <i class="fas fa-briefcase"></i>
        <h3>Poste concerné</h3>
      </div>
      <div class="preview-body">
        <h4><%= @job.title %></h4>
        <p><%= truncate(@job.description, length: 250) %></p>
        <%= link_to "Voir le détail du poste", job_path(@job), class: "link-subtle" %>
      </div>
    </div>

    <div class="application-form-card">
      <%= form_with(model: @application, url: job_applications_path(@job), local: true, class: "application-form") do |f| %>
        <% if @application.errors.any? %>
          <div class="alert alert-danger">
            <h4><%= pluralize(@application.errors.count, "erreur") %></h4>
            <ul>
              <% @application.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-section">
          <h3 class="section-title">
            <i class="fas fa-user"></i>
            Vos informations
          </h3>
          <div class="form-group">
            <p class="form-hint">Votre message sera envoyé directement à notre équipe.</p>
          </div>
        </div>

        <div class="form-section">
          <h3 class="section-title">
            <i class="fas fa-envelope-open-text"></i>
            Lettre de motivation
          </h3>
          <div class="form-group">
            <%= f.label :message do %>
              Présentez-vous et expliquez votre intérêt <span class="required">*</span>
            <% end %>
            <%= f.text_area :message,
                placeholder: "Parlez-nous de votre expérience, vos compétences et pourquoi vous souhaitez rejoindre notre équipe STAFOTEL...",
                class: "form-textarea",
                rows: 10 %>
            <small class="form-hint">Décrivez votre parcours professionnel et vos motivations</small>
          </div>
        </div>

        <%= f.hidden_field :job_id, value: @job.id %>
        <%= f.hidden_field :status, value: "pending" %>
        <%= f.hidden_field :contact_id, value: @admin_contact&.id %>

        <div class="form-actions">
          <%= f.submit "Envoyer ma candidature", class: "btn-primary" %>
          <%= link_to "Annuler", job_path(@job), class: "btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="info-banner-elegant">
    <div class="banner-icon">
      <i class="fas fa-info-circle"></i>
    </div>
    <div class="banner-content">
      <h4>Traitement de votre candidature</h4>
      <p>Votre candidature sera examinée avec attention par notre équipe. Nous vous contacterons dans les plus brefs délais si votre profil correspond à nos besoins.</p>
    </div>
  </div>
</div>
