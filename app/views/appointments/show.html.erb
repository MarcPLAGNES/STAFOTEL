<div class="appointment-page">
  <div class="appointment-container">
    <!-- Header -->
    <div class="appointment-header">
      <div class="appointment-back">
        <%= link_to "← Retour", quote_path(@appointment.quote), class: "back-link" %>
      </div>
      <div class="appointment-logo">
        <h1>STAFOTEL</h1>
        <p>Confirmation de Rendez-vous</p>
      </div>
    </div>

    <!-- Référence -->
    <div class="appointment-reference">
      <div class="ref-item">
        <span class="label">RDV N°</span>
        <span class="value"><%= @appointment.id %></span>
      </div>
      <div class="ref-item">
        <span class="label">Date du RDV</span>
        <span class="value"><%= l(@appointment.date, format: :long) if @appointment.date %></span>
      </div>
      <div class="ref-item">
        <span class="label">Statut</span>
        <span class="value status-<%= @appointment.status %>">
          <% case @appointment.status
             when "pending" %>En attente
          <% when "confirmed" %>Confirmé
          <% when "cancelled" %>Annulé
          <% else %>
            <%= @appointment.status %>
          <% end %>
        </span>
      </div>
    </div>

    <!-- Divider -->
    <div class="appointment-divider"></div>

    <!-- Content -->
    <div class="appointment-content">
      <!-- Quote Info -->
      <section class="appointment-section">
        <h3 class="section-title">Devis Associé</h3>
        <div class="quote-card">
          <h2>Devis N° <%= @appointment.quote.id %></h2>
          <p><strong>Service:</strong> <%= @appointment.quote.service.name %></p>
          <p><strong>Message:</strong> <%= @appointment.quote.message %></p>
          <%= link_to "Voir le devis", quote_path(@appointment.quote), class: "btn-link" %>
        </div>
      </section>

      <!-- Contact Info -->
      <section class="appointment-section">
        <h3 class="section-title">Contact</h3>
        <div class="info-grid">
          <div class="info-item">
            <span class="label">Nom</span>
            <span class="value"><%= "#{@appointment.contact.firstname} #{@appointment.contact.lastname}" %></span>
          </div>
          <div class="info-item">
            <span class="label">Email</span>
            <span class="value"><%= @appointment.contact.email %></span>
          </div>
          <div class="info-item">
            <span class="label">Téléphone</span>
            <span class="value"><%= @appointment.contact.phone %></span>
          </div>
        </div>
      </section>
    </div>

    <!-- Actions -->
    <div class="appointment-actions">
      <% if @appointment.status == "pending" %>
        <div class="action-buttons">
          <%= link_to "Confirmer", update_status_appointment_path(@appointment, appointment: { status: "confirmed" }), method: :patch, class: "btn btn-confirm" %>
          <%= link_to "Annuler", update_status_appointment_path(@appointment, appointment: { status: "cancelled" }), method: :patch, class: "btn btn-cancel-rdv" %>
        </div>
      <% elsif @appointment.status == "confirmed" %>
        <div class="alert alert-success">
          <i class="fas fa-check-circle"></i> Rendez-vous confirmé
        </div>
      <% elsif @appointment.status == "cancelled" %>
        <div class="alert alert-danger">
          <i class="fas fa-times-circle"></i> Rendez-vous annulé
        </div>
      <% end %>
    </div>

    <!-- Footer -->
    <div class="appointment-footer">
      <p><strong>STAFOTEL</strong> - Nous vous contacterons pour confirmer les détails</p>
    </div>
  </div>
</div>
