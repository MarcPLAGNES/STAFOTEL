<div class="quote-form-page">
  <div class="quote-form-container">
    <!-- Header -->
    <div class="quote-form-header">
      <div class="form-back">
        <%= link_to "← Retour", service_path(@service), class: "back-link" %>
      </div>
      <div class="form-title">
        <h1>Demande de Devis</h1>
        <p><%= @service.name %></p>
      </div>
    </div>

    <!-- Service Info -->
    <div class="service-info-box">
      <div class="service-details">
        <h3><%= @service.name %></h3>
        <p><%= @service.description %></p>
      </div>
    </div>

    <!-- Form -->
    <div class="quote-form">
      <%= form_with(model: @quote, url: service_quotes_path(@service), local: true) do |f| %>
        <% if @quote.errors.any? %>
          <div class="error-box">
            <h2><%= pluralize(@quote.errors.count, "erreur") %> détectée(s):</h2>
            <ul>
              <% @quote.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Contact Section -->
        <fieldset class="form-section">
          <legend>Vos Informations</legend>

          <div class="form-group">
            <%= f.label :contact_firstname, "Prénom" %>
            <%= f.text_field :contact_firstname, placeholder: "Votre prénom", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :contact_lastname, "Nom" %>
            <%= f.text_field :contact_lastname, placeholder: "Votre nom", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :contact_email, "Email" %>
            <%= f.email_field :contact_email, placeholder: "votre.email@exemple.com", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :contact_phone, "Téléphone" %>
            <%= f.telephone_field :contact_phone, placeholder: "06 12 34 56 78", class: "form-control" %>
          </div>
        </fieldset>

        <!-- Message Section -->
        <fieldset class="form-section">
          <legend>Détails de votre Demande</legend>

          <div class="form-group">
            <%= f.label :message, "Description de votre besoin" %>
            <%= f.text_area :message, placeholder: "Décrivez votre demande en détail...", class: "form-control", rows: 6 %>
            <small>Donnez-nous le maximum de détails pour un devis précis</small>
          </div>
        </fieldset>

        <!-- Hidden fields -->
        <%= f.hidden_field :service_id, value: @service.id %>

        <!-- Submit -->
        <div class="form-actions">
          <%= f.submit "Demander un devis", class: "btn btn-submit" %>
          <%= link_to "Annuler", service_path(@service), class: "btn btn-cancel" %>
        </div>
      <% end %>
    </div>

    <!-- Info Box -->
    <div class="info-banner">
      <i class="fas fa-info-circle"></i>
      <p>Un devis vous sera envoyé dans les 24h à l'adresse email de votre contact.</p>
    </div>
  </div>
</div>
