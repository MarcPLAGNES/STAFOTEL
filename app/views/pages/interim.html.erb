<div class="service-mode-page">
  <div class="mode-hero">
    <div class="mode-hero-content">
      <div class="mode-icon-large">
        <i class="fas fa-users"></i>
      </div>
      <h1>Personnel en Intérim</h1>
      <p class="hero-subtitle">Renforcez vos équipes avec du personnel qualifié disponible rapidement</p>
    </div>
  </div>

  <div class="container mode-container">
    <%= link_to root_path, class: "back-link-stylized" do %>
      <span class="back-icon">
        <i class="fas fa-arrow-left"></i>
      </span>
      <span class="back-text">Retour à l'accueil</span>
    <% end %>

    <!-- Section Introduction -->
    <section class="mode-intro-section">
      <div class="intro-content">
        <h2>Du personnel qualifié quand vous en avez besoin</h2>
        <p class="lead">
          STAFOTEL met à votre disposition du personnel qualifié en intérim pour renforcer vos équipes
          lors de vos pics d'activité, remplacements ou besoins ponctuels. Réactivité, flexibilité
          et professionnalisme garantis.
        </p>
      </div>
    </section>

    <!-- Section Comment ça marche -->
    <section class="how-it-works-section">
      <h2>Comment ça marche ?</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>Votre demande</h3>
          <p>Vous nous communiquez vos besoins : poste, durée, horaires, compétences requises et date de début souhaitée.</p>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <h3>Sélection du profil</h3>
          <p>Nous identifions rapidement le ou les profils correspondant parfaitement à vos exigences parmi notre vivier de talents.</p>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <h3>Mise à disposition</h3>
          <p>Le personnel sélectionné rejoint vos équipes selon vos plannings et s'intègre immédiatement à vos processus.</p>
        </div>

        <div class="step-card">
          <div class="step-number">4</div>
          <h3>Suivi & Ajustement</h3>
          <p>Nous assurons un suivi régulier de la mission et restons disponibles pour tout ajustement ou besoin complémentaire.</p>
        </div>
      </div>
    </section>

    <!-- Section Avantages -->
    <section class="benefits-section">
      <h2>Les avantages de l'intérim</h2>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-bolt"></i>
          </div>
          <h3>Réactivité</h3>
          <p>Personnel disponible rapidement, souvent sous 24-48h, pour répondre à vos urgences et besoins immédiats.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-calendar-check"></i>
          </div>
          <h3>Flexibilité totale</h3>
          <p>Durée de mission adaptée à vos besoins : de quelques jours à plusieurs mois, renouvelable selon votre activité.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-user-graduate"></i>
          </div>
          <h3>Personnel qualifié</h3>
          <p>Tous nos intérimaires sont formés, expérimentés et immédiatement opérationnels dans votre secteur d'activité.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-euro-sign"></i>
          </div>
          <h3>Maîtrise budgétaire</h3>
          <p>Pas de charges fixes : vous ne payez que pour les heures réellement travaillées, sans engagement long terme.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-file-contract"></i>
          </div>
          <h3>Simplicité administrative</h3>
          <p>Nous gérons tous les aspects administratifs : contrats, paie, déclarations sociales, assurances.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-sync"></i>
          </div>
          <h3>Remplacement garanti</h3>
          <p>En cas d'absence ou de problème, nous remplaçons immédiatement l'intérimaire pour assurer la continuité.</p>
        </div>
      </div>
    </section>

    <!-- Section Profils disponibles -->
    <section class="profiles-section">
      <h2>Profils disponibles en intérim</h2>
      <div class="profiles-grid">
        <div class="profile-card">
          <i class="fas fa-concierge-bell"></i>
          <h3>Gouvernant(e)</h3>
          <p>Gestion et coordination des équipes de nettoyage</p>
        </div>

        <div class="profile-card">
          <i class="fas fa-broom"></i>
          <h3>Femme/Valet de chambre</h3>
          <p>Nettoyage et entretien des chambres</p>
        </div>

        <div class="profile-card">
          <i class="fas fa-tshirt"></i>
          <h3>Linger(ère)</h3>
          <p>Gestion et entretien de la lingerie</p>
        </div>

        <div class="profile-card">
          <i class="fas fa-utensils"></i>
          <h3>Plongeur/Cafetier</h3>
          <p>Entretien des cuisines et vaisselle</p>
        </div>

        <div class="profile-card">
          <i class="fas fa-spray-can"></i>
          <h3>Agent d'entretien</h3>
          <p>Nettoyage des espaces communs</p>
        </div>

        <div class="profile-card">
          <i class="fas fa-user-tie"></i>
          <h3>Responsable nettoyage</h3>
          <p>Supervision et contrôle qualité</p>
        </div>
      </div>
    </section>

    <!-- Section CTA -->
    <section class="cta-section">
      <div class="cta-card" style="background: #1a1a1a !important; background-image: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%) !important;">
        <h2 style="color: #ffffff !important; background-color: #1a1a1a !important;">Besoin de renfort rapidement ?</h2>
        <p style="color: #d4af37 !important;">Décrivez-nous votre besoin et nous vous proposerons des profils adaptés</p>
        <%= link_to "Contactez-nous", contact_path, class: "cta-button" %>
      </div>
    </section>
  </div>
</div>
