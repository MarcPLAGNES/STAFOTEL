<div class="container tips-page">
  <h1>Nos Astuces de Nettoyage</h1>
  <p class="page-intro">Découvrez nos conseils d'experts pour un nettoyage professionnel</p>

  <% if @tips.any? %>
    <div class="tips-grid">
      <% @tips.each_with_index do |tip, index| %>
        <div class="card-trip">
          <div class="tip-image-container">
            <%= link_to image_tag(tip.image, class: "d-block w-100", height: 300, alt: tip.title), tip_path(tip) %>
          </div>
          <div class="tip-content">
            <h4><%= tip.title %></h4>
            <p class="tip-intro"><%= tip.intro %></p>
            <%= link_to "Lire l'astuce", tip_path(tip), class: "btn btn-flat" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <p>Aucune astuce n'est actuellement disponible.</p>
    </div>
  <% end %>
</div>
