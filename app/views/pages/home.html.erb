<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url('<%= asset_path("Img1.png") %>');">
  <div class="container">
    <h1><%= image_tag("Logo.png", width: 350, height: 180) %></h1>
    <p><strong>Spécialiste du nettoyage hôtelier et restauration</strong></p>
    <p class="banner-subtitle">Personnel qualifié, formé et disponible pour vos besoins 7/7j</p>
  </div>
  <div class="button-container">
    <%= link_to "Demander un devis", jobs_path, class: "btn btn-flat" %>
  </div>
</div>

<h2>Découvrez nos métiers</h2>

<div class="box container">
  <div id="carousel" class="carousel slide" data-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <div class="cards d-flex justify-content-center">
          <div class="card-trip">
            <div><h4><%= @job1.title %></h4></div>
            <%= link_to jobs_path(@job1) do %>
              <%= image_tag("job1.png", class: "d-block w-100", height: 300) %>
            <% end %>
          </div>
          <div class="card-trip">
            <div><h4><%= @job2.title %></h4></div>
            <%= link_to jobs_path(@job2) do %>
              <%= image_tag("job2.png", class: "d-block w-100", height: 300) %>
            <% end %>
          </div>
          <div class="card-trip">
            <div><h4><%= @job3.title %></h4></div>
            <%= link_to jobs_path(@job3) do %>
              <%= image_tag("job3.png", class: "d-block w-100", height: 300) %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="carousel-item">
        <div class="cards d-flex justify-content-center">
          <div class="card-trip">
            <div><h4><%= @job4.title %></h4></div>
            <%= link_to jobs_path(@job4) do %>
              <%= image_tag("job4.png", class: "d-block w-100", height: 300) %>
            <% end %>
          </div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>
</div>

<h2>Nos services de nettoyages</h2>
<div class="box container">
  <div id="carousel-services" class="carousel slide" data-ride="carousel">
    <div class="carousel-inner">
      <% if @services.any? %>
        <div class="carousel-item active">
          <div class="cards d-flex justify-content-center">
            <% @services.first(3).each_with_index do |service, index| %>
              <div class="card-trip">
                <div><h4><%= service.name %></h4></div>
                <%= link_to service_path(service) do %>
                  <%= image_tag("Service#{index + 1}.png", class: "d-block w-100", height: 300, alt: service.name) %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="carousel-item active">
          <div class="cards d-flex justify-content-center">
            <p>Aucun service disponible pour le moment.</p>
          </div>
        </div>
      <% end %>
    </div>
    <% if @services.count > 3 %>
      <a class="carousel-control-prev" href="#carousel-services" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
      </a>
      <a class="carousel-control-next" href="#carousel-services" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
      </a>
    <% end %>
  </div>
</div>

<h2>Pourquoi nous choisir ?</h2>
<section class="why-us-section">
  <div class="cards d-flex justify-content-center">
    <div class="card-trip card-icon">
      <div class="card-icon-content">
        <i class="fas fa-user-check"></i>
        <h4>Personnel Formé</h4>
        <p>Équipe professionnelle et qualifiée pour vos besoins</p>
      </div>
    </div>
    <div class="card-trip card-icon">
      <div class="card-icon-content">
        <i class="fas fa-clock"></i>
        <h4>Réactivité 7j/7</h4>
        <p>Disponible tous les jours de la semaine</p>
      </div>
    </div>
    <div class="card-trip card-icon">
      <div class="card-icon-content">
        <i class="fas fa-bolt"></i>
        <h4>Interventions Rapides</h4>
        <p>Mobilité et efficacité garanties</p>
      </div>
    </div>
    <div class="card-trip card-icon">
      <div class="card-icon-content">
        <i class="fas fa-check-circle"></i>
        <h4>Contrôle Qualité</h4>
        <p>Vérification rigoureuse à chaque intervention</p>
      </div>
    </div>
  </div>
</section>

<h2>Nos astuces pour nettoyer</h2>
<section class="tips-section">
  <div id="carousel-tips" class="carousel slide" data-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <div class="cards d-flex justify-content-center">
          <div class="card-trip">
            <div><h4>Bien nettoyer les vitres de salle de bain</h4></div>
            <%= link_to tips_path do %>
              <%= image_tag("Tips1.JPG", class: "d-block w-100", alt: "Astuce: vitres de salle de bain") %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<h2>Nos clients</h2>
<section class="clients-section">
  <div class="clients-logos">
    <%= image_tag("Partenaire 1.png", alt: "Partenaire 1", class: "partner-logo") %>
    <%= image_tag("Partenaire 2.png", alt: "Partenaire 2", class: "partner-logo") %>
    <%= image_tag("Partenaire 3.jpg", alt: "Partenaire 3", class: "partner-logo") %>
  </div>
</section>
