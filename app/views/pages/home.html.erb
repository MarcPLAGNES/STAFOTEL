      <span class="visually-hidden">Next</span>
    </button>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
// Tableau de tous les jobs avec les vrais noms d'images
const allJobs = [
  {
    title: '<%= @job1&.title %>',
    imageSrc: '<%= asset_path("Gouvernant.webp") %>',
    imageClass: 'job-gouvernant',
    path: '<%= job_path(@job1) if @job1 %>'
  },
  {
    title: '<%= @job2&.title %>',
    imageSrc: '<%= asset_path("Linger.webp") %>',
    imageClass: 'job-linger',
    path: '<%= job_path(@job2) if @job2 %>'
  },
  {
    title: '<%= @job3&.title %>',
    imageSrc: '<%= asset_path("Femme et Valet.webp") %>',
    imageClass: 'job-femme-menage',
    path: '<%= job_path(@job3) if @job3 %>'
  },
  {
    title: '<%= @job4&.title %>',
    imageSrc: '<%= asset_path("Cafetier.webp") %>',
    imageClass: 'job-cafetier',
    path: '<%= job_path(@job4) if @job4 %>'
  },
  {
    title: '<%= @job5&.title %>',
    imageSrc: '<%= asset_path("Commis de cuisine.webp") %>',
    imageClass: 'job-commis-cuisine',
    path: '<%= job_path(@job5) if @job5 %>'
  },
  {
    title: '<%= @job6&.title %>',
    imageSrc: '<%= asset_path("Réceptionniste.webp") %>',
    imageClass: 'job-receptionniste',
    path: '<%= job_path(@job6) if @job6 %>'
  },
  {
    title: '<%= @job7&.title %>',
    imageSrc: '<%= asset_path("Technicien.webp") %>',
    imageClass: 'job-technicien',
    path: '<%= job_path(@job7) if @job7 %>'
  },
  {
    title: '<%= @job8&.title %>',
    imageSrc: '<%= asset_path("Equipier.webp") %>',
    imageClass: 'job-equipier',
    path: '<%= job_path(@job8) if @job8 %>'
  }
];

let currentIndex = 0;

function getVisibleJobCards() {
  if (window.innerWidth <= 768) return 1;
  if (window.innerWidth <= 1024) return 2;
  return 3;
}

function renderJobs() {
  const wrapper = document.getElementById('job-cards-wrapper');
  wrapper.innerHTML = '';

  const visibleJobs = Math.min(getVisibleJobCards(), allJobs.length);

  for (let i = 0; i < visibleJobs; i++) {
    const jobIndex = (currentIndex + i) % allJobs.length;
    const job = allJobs[jobIndex];

    const card = document.createElement('div');
    card.className = 'card-trip';
    card.innerHTML = `
      <div><h4>${job.title}</h4></div>
      <div class="job-image-container">
        <a href="${job.path}">
          <img src="${job.imageSrc}" class="d-block w-100 ${job.imageClass}" alt="${job.title}">
        </a>
      </div>
    `;
    wrapper.appendChild(card);
  }
}

function scrollJobs(direction) {
  currentIndex = (currentIndex + direction + allJobs.length) % allJobs.length;
  renderJobs();
}

// Initialiser l'affichage au chargement
document.addEventListener('turbo:load', function() {
  renderJobs();

  document.querySelectorAll('.js-scroll-jobs').forEach((button) => {
    if (button.dataset.bound === 'true') return;
    button.addEventListener('click', () => {
      scrollJobs(Number(button.dataset.direction || 0));
    });
    button.dataset.bound = 'true';
  });

  if (!window.__jobsResizeBound) {
    window.addEventListener('resize', renderJobs);
    window.__jobsResizeBound = true;
  }
});

// --- Carousel Tips ---
const allTips = <%= raw(@tips&.map { |t| { title: t.title, intro: t.intro, imageSrc: asset_path(t.image), path: tip_path(t) } }&.to_json || '[]') %>;
let currentTipIndex = 0;

function getVisibleTipCards() {
  if (window.innerWidth <= 768) return 1;
  if (window.innerWidth <= 1024) return 2;
  return 3;
}

function renderTips() {
  const wrapper = document.getElementById('tip-cards-wrapper');
  if (!wrapper) {
    console.warn('Wrapper #tip-cards-wrapper not found');
    return;
  }

  if (!allTips || allTips.length === 0) {
    console.warn('No tips available:', allTips);
    wrapper.innerHTML = '<p class="text-muted">Aucune astuce disponible pour le moment.</p>';
    wrapper.style.display = 'flex';
    return;
  }

  wrapper.innerHTML = '';
  const visible = Math.min(getVisibleTipCards(), allTips.length);
  for (let i = 0; i < visible; i++) {
    const tipIndex = (currentTipIndex + i) % allTips.length;
    const tip = allTips[tipIndex];

    const card = document.createElement('div');
    card.className = 'tip-card-compact';
    card.innerHTML = `
      <div class="tip-image-container">
        <a href="${tip.path}">
          <img src="${tip.imageSrc}" alt="${tip.title}">
        </a>
      </div>
      <div class="tip-content">
        <h4>${tip.title}</h4>
        <p class="tip-intro">${(tip.intro || '').slice(0, 110)}${(tip.intro || '').length > 110 ? '…' : ''}</p>
        <a href="${tip.path}" class="btn btn-flat">Lire l'astuce</a>
      </div>
    `;
    wrapper.appendChild(card);
  }
  wrapper.style.display = 'flex';
}

function scrollTips(direction) {
  if (!allTips.length) return;
  currentTipIndex = (currentTipIndex + direction + allTips.length) % allTips.length;
  renderTips();
}

const allServices = <%= raw(@services&.each_with_index&.map { |service, idx| { name: service.name, path: service_path(service), imageSrc: asset_path("Service#{(idx % 3) + 1}.webp") } }&.to_json || '[]') %>;
let currentServiceIndex = 0;

function getVisibleServiceCards() {
  if (window.innerWidth <= 768) return 1;
  if (window.innerWidth <= 1024) return 2;
  return 3;
}

function renderServices() {
  const wrapper = document.getElementById('service-cards-wrapper');
  if (!wrapper) return;

  if (!allServices.length) {
    wrapper.innerHTML = '<p>Aucun service disponible pour le moment.</p>';
    wrapper.style.display = 'flex';
    return;
  }

  wrapper.innerHTML = '';
  const visible = Math.min(getVisibleServiceCards(), allServices.length);

  for (let i = 0; i < visible; i++) {
    const serviceIndex = (currentServiceIndex + i) % allServices.length;
    const service = allServices[serviceIndex];

    const card = document.createElement('div');
    card.className = 'card-trip';
    card.innerHTML = `
      <div><h4>${service.name}</h4></div>
      <a href="${service.path}">
        <img src="${service.imageSrc}" class="d-block w-100" height="300" alt="${service.name}">
      </a>
    `;
    wrapper.appendChild(card);
  }

  wrapper.style.display = 'flex';
}

function scrollServices(direction) {
  if (!allServices.length) return;
  currentServiceIndex = (currentServiceIndex + direction + allServices.length) % allServices.length;
  renderServices();
}

document.addEventListener('turbo:load', function() {
  console.log('turbo:load - Tips data:', allTips?.length || 0);
  setTimeout(() => {
    renderTips();
    renderServices();
  }, 50);

  document.querySelectorAll('.js-scroll-services').forEach((button) => {
    if (button.dataset.bound === 'true') return;
    button.addEventListener('click', () => {
      scrollServices(Number(button.dataset.direction || 0));
    });
    button.dataset.bound = 'true';
  });

  document.querySelectorAll('.js-scroll-tips').forEach((button) => {
    if (button.dataset.bound === 'true') return;
    button.addEventListener('click', () => {
      scrollTips(Number(button.dataset.direction || 0));
    });
    button.dataset.bound = 'true';
  });

  if (!window.__tipsResizeBound) {
    window.addEventListener('resize', renderTips);
    window.__tipsResizeBound = true;
  }

  if (!window.__servicesResizeBound) {
    window.addEventListener('resize', renderServices);
    window.__servicesResizeBound = true;
  }
});
</script>

