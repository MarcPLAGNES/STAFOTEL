<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url('<%= asset_path("Img1.png") %>');">
  <div class="container">
    <h1><%= image_tag("Logo.png", width: 350, height: 180) %></h1>
    <p><strong>Loue ton deck, domine les tournois!</strong></p>
    <div class="button-container">
      <%= link_to "Louer un deck", jobs_path, class: "btn btn-flat" %>
    </div>
  </div>
</div>

<h2>"Découvrez nos derniers decks exclusifs et boostez vos performances !"</h2>

<div class="box container">
  <div id="carousel" class="carousel slide" data-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <div class="cards d-flex" alt="First slide">
          <div class="card-trip">
            <div><h4><%= @job1.title %></h4></div>
            <%= link_to jobs_path(@job1) do %>
              <%= image_tag("job1.png", class: "d-block w-100", height: 400) %>
              <div class="card-trip-infos">
                <img src="https://kitt.lewagon.com/placeholder/users/krokrob" class="card-trip-user avatar-bordered" />
              </div>
            <% end %>
          </div>
          <div class="card-trip">
            <div><h4><%= @job2.title %></h4></div>
            <%= link_to jobs_path(@job2) do %>
              <%= image_tag("job2.png", class: "d-block w-100", height: 400) %>
              <div class="card-trip-infos">
                <img src="https://kitt.lewagon.com/placeholder/users/krokrob" class="card-trip-user avatar-bordered" />
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="carousel-item">
        <div class="cards  d-flex" alt="Second slide">
          <div class="card-trip">
            <div><h4><%= @job3.title %></h4></div>
            <%= link_to jobs_path(@job3) do %>
              <%= image_tag("job3.png", class: "d-block w-100", height: 400) %>
              <div class="card-trip-infos">
                <img src="https://kitt.lewagon.com/placeholder/users/krokrob" class="card-trip-user avatar-bordered" />
              </div>
            <% end %>
          </div>
          <div class="card-trip">
            <div><h4><%= @job4.title %></h4></div>
            <%= link_to jobs_path(@job4) do %>
              <%= image_tag("job4.png", class: "d-block w-100", height: 400) %>
              <div class="card-trip-infos">
                <img src="https://kitt.lewagon.com/placeholder/users/krokrob" class="card-trip-user avatar-bordered" />
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>
</div>
