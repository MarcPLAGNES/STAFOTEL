<div class="service-mode-page">
  <div class="mode-hero">
    <div class="mode-hero-content">
      <div class="mode-icon-large">
        <i class="fas fa-handshake"></i>
      </div>
      <h1>Sous-traitance en Nettoyage</h1>
      <p class="hero-subtitle">Déléguez l'intégralité de vos besoins en nettoyage à des experts</p>
    </div>
  </div>

  <div class="container mode-container">
    <%= link_to root_path, class: "back-link-stylized" do %>
      <span class="back-icon">
        <i class="fas fa-arrow-left"></i>
      </span>
      <span class="back-text">Retour à l'accueil</span>
    <% end %>

    <!-- Section Introduction -->
    <section class="mode-intro-section">
      <div class="intro-content">
        <h2>Une solution clé en main pour votre établissement</h2>
        <p class="lead">
          STAFOTEL prend en charge l'intégralité de vos besoins en nettoyage hôtelier et restauration.
          De la gestion du personnel à la garantie de qualité, nous vous libérons de toutes les contraintes
          opérationnelles pour vous permettre de vous concentrer sur votre cœur de métier.
        </p>
      </div>
    </section>

    <!-- Section Comment ça marche -->
    <section class="how-it-works-section">
      <h2>Comment ça marche ?</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>Analyse de vos besoins</h3>
          <p>Nous étudions ensemble vos attentes, vos contraintes et vos standards de qualité pour établir un cahier des charges précis.</p>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <h3>Recrutement & Formation</h3>
          <p>Nous recrutons et formons du personnel qualifié selon vos exigences spécifiques et les normes de votre établissement.</p>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <h3>Planification & Intervention</h3>
          <p>Nous organisons les plannings, gérons les équipes et assurons les interventions selon vos horaires et contraintes.</p>
        </div>

        <div class="step-card">
          <div class="step-number">4</div>
          <h3>Contrôle Qualité</h3>
          <p>Nous vérifions systématiquement la qualité de chaque prestation et ajustons nos méthodes pour garantir votre satisfaction.</p>
        </div>
      </div>
    </section>

    <!-- Section Avantages -->
    <section class="benefits-section">
      <h2>Les avantages de la sous-traitance</h2>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-briefcase"></i>
          </div>
          <h3>Gestion complète</h3>
          <p>Nous prenons en charge tous les aspects : recrutement, formation, gestion administrative, remplacement en cas d'absence.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-chart-line"></i>
          </div>
          <h3>Optimisation des coûts</h3>
          <p>Réduisez vos charges de personnel, vos coûts de formation et votre gestion administrative grâce à notre expertise.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-shield-alt"></i>
          </div>
          <h3>Garantie de continuité</h3>
          <p>Nous assurons la continuité de service 7j/7, même en cas d'absences ou de pics d'activité.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-star"></i>
          </div>
          <h3>Qualité professionnelle</h3>
          <p>Personnel formé aux standards les plus exigeants de l'hôtellerie et de la restauration.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-clock"></i>
          </div>
          <h3>Flexibilité</h3>
          <p>Adaptation rapide à vos variations d'activité, événements spéciaux et besoins ponctuels.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <i class="fas fa-balance-scale"></i>
          </div>
          <h3>Conformité juridique</h3>
          <p>Nous gérons tous les aspects juridiques, sociaux et réglementaires liés au personnel.</p>
        </div>
      </div>
    </section>

    <!-- Section Nos Services -->
    <section class="services-included-section">
      <h2>Prestations incluses</h2>
      <div class="included-grid">
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Nettoyage des chambres et espaces communs</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Gestion de la lingerie</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Entretien des cuisines et restaurants</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Nettoyage des sanitaires</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Personnel qualifié (gouvernante, femme de chambre, plongeur...)</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Contrôle qualité régulier</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Reporting et suivi personnalisé</span>
        </div>
        <div class="included-item">
          <i class="fas fa-check-circle"></i>
          <span>Interventions d'urgence</span>
        </div>
      </div>
    </section>

    <!-- Section CTA -->
    <section class="cta-section">
      <div class="cta-card" style="background: #1a1a1a !important; background-image: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%) !important;">
        <h2 style="color: #ffffff !important; background-color: #1a1a1a !important;">Prêt à sous-traiter votre nettoyage ?</h2>
        <p style="color: #d4af37 !important;">Demandez un devis personnalisé adapté à votre établissement</p>
        <%= link_to "Contactez-nous", contact_path(source: "sous_traitance"), class: "cta-button-secondary" %>
      </div>
    </section>
  </div>
</div>
