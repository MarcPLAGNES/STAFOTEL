<div class="container jobs-page">
  <h1>Nos Métiers</h1>
  <p class="page-intro">Découvrez les professionnels du nettoyage hôtelier et restauration</p>

  <% if @jobs.any? %>
    <div class="jobs-grid">
      <% @jobs.each do |job| %>
        <div class="card-trip">
          <div class="job-image-container">
            <%= link_to job_path(job) do %>
              <%
                job_images = {
                  'Cafetier(ère)' => { name: 'Cafetier.webp', class: 'job-cafetier' },
                  'Gouvernant(e)' => { name: 'Gouvernant.webp', class: 'job-gouvernant' },
                  'Commis de cuisine' => { name: 'Commis de cuisine.webp', class: 'job-commis-cuisine' },
                  'Valet/Femme de chambre' => { name: 'Femme et Valet.webp', class: 'job-femme-menage' },
                  'Linger(ère)' => { name: 'Linger.webp', class: 'job-linger' },
                  'Réceptionniste' => { name: 'Réceptionniste.webp', class: 'job-receptionniste' },
                  'Technicien polyvalent' => { name: 'Technicien.webp', class: 'job-technicien' },
                  'Technicien en hôtellerie' => { name: 'Technicien.webp', class: 'job-technicien' },
                  'Équipier polyvalent' => { name: 'Equipier.webp', class: 'job-equipier' }
                }
                image_info = job_images[job.title] || { name: 'Gouvernant.webp', class: 'job-gouvernant' }
              %>
              <%= image_tag(image_info[:name], class: "d-block w-100 #{image_info[:class]}", height: 300, alt: job.title) %>
            <% end %>
          </div>
          <div class="job-content">
            <h4><%= job.title %></h4>
            <p class="job-description"><%= truncate(job.description, length: 150) %></p>
            <%= link_to "En savoir plus", job_path(job), class: "btn btn-flat" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <p>Aucun métier n'est actuellement disponible.</p>
    </div>
  <% end %>
</div>
