<div class="login-container">
  <div class="login-box">
    <h2 class="login-title">Connexion</h2>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
      <div class="form-inputs" data-controller="password-toggle">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email", class: "form-input" },
                    label: "Email" %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password", class: "form-input", data: { password_toggle_target: "input" } },
                    label: "Mot de passe" %>
        <div class="form-check mt-2 mb-3">
          <input class="form-check-input" type="checkbox" id="show-passwords-session" data-action="password-toggle#toggle">
          <label class="form-check-label" for="show-passwords-session">Afficher les mots de passe</label>
        </div>
        <%= f.input :remember_me, as: :boolean, label: "Se souvenir de moi" if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Se connecter", class: "btn btn-login" %>
      </div>
    <% end %>

    <div class="login-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
